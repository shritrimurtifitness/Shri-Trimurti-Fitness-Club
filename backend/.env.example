PORT=5000
DATABASE_URL=postgresql://user:password@your-database-host:5432/dbname?sslmode=require
JWT_SECRET=your-super-secret-jwt-key
FRONTEND_URL=http://localhost:5173
CRON_SECRET=your-cron-cleanup-secret-key

# Razorpay Payment Gateway
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# Cloudinary Credentials for Media & Banners
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Redis Cache & Rate Limiting
REDIS_URL=redis://localhost:6379

# Email Delivery (Dual-Provider: Brevo with Resend fallback)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SENDER_EMAIL=hello@yourdomain.com
RESEND_API_KEY=your_resend_api_key_here
